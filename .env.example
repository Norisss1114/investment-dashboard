# ==========================================================
#  .env.example  —  コピーして .env を作成してください
#  v4: ニュース/AIを重視するため、FINNHUB と OPENAI を「推奨（実質必須）」にしています。
#      未設定でも代替モード（サンプル見出し＋簡易キーワード分類）で起動はしますが、
#      スコアの信頼性が下がります。
# ==========================================================

# --- 【推奨・必須級】実ニュース取得: https://finnhub.io で無料キー取得 ---
FINNHUB_API_KEY=

# --- 【推奨・必須級】AIニュース分類: https://platform.openai.com ---
OPENAI_API_KEY=

# --- 任意: OpenAIの代替として使う場合のみ ---
ANTHROPIC_API_KEY=

# --- データ取得モードの強制（任意） ---
# 1=常にサンプル / 0=常にライブ(yfinance) / 空=自動判定
MOCK_MODE=
